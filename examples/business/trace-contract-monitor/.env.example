APPLICATION_NAME=evm-trace-contract-monitor
NODE_ENV=development
LOG_LEVEL=info
NETWORK_CHAIN_ID=1
NETWORK_NATIVE_CURRENCY_SYMBOL=ETH
NETWORK_NATIVE_CURRENCY_DECIMALS=18
NETWORK_BLOCK_TIME_SECONDS=12
NETWORK_HAS_EIP1559=true
NETWORK_HAS_WITHDRAWALS=true
NETWORK_HAS_BLOB_TRANSACTIONS=true
NETWORK_SUPPORTS_TRACES=true
NETWORK_VERIFY_TRIE=false
NETWORK_TRACE_STRATEGY=auto
TRACES_ENABLED=true
TRANSPORT_HTTP_HOST=0.0.0.0
TRANSPORT_HTTP_PORT=3000
START_BLOCK_HEIGHT=
MAX_BLOCK_HEIGHT=
# WETH on Ethereum mainnet by default — useful for contract call tracing.
WATCH_TRACE_CONTRACT=0xc02aa39b223fe8d0a0e5c4f27ead9083c756cc2
PROVIDER_NETWORK_RPC_URLS=
