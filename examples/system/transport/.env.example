APPLICATION_NAME=evm-native-balance-watcher
NODE_ENV=development
LOG_LEVEL=info
NETWORK_CHAIN_ID=1
NETWORK_NATIVE_CURRENCY_SYMBOL=ETH
NETWORK_NATIVE_CURRENCY_DECIMALS=18
NETWORK_BLOCK_TIME_SECONDS=12
NETWORK_HAS_EIP1559=true
NETWORK_HAS_WITHDRAWALS=true
NETWORK_HAS_BLOB_TRANSACTIONS=true
NETWORK_SUPPORTS_TRACES=false
TRANSPORT_HTTP_HOST=0.0.0.0
TRANSPORT_HTTP_PORT=3000
# Keep empty to start from the current tip on mainnet.
START_BLOCK_HEIGHT=
MAX_BLOCK_HEIGHT=
WATCH_ADDRESSES=0xd8da6bf26964af9d7eed9e03e53415d37aa96045
PROVIDER_NETWORK_RPC_URLS=
TRANSPORT_OUTBOX_ENABLE=1
TRANSPORT_OUTBOX_KIND=ipc-child
